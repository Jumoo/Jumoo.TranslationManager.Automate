<Project>
	<PropertyGroup>
		<VersionPrefix>17.0.0</VersionPrefix>
		<Authors>Kevin Jump</Authors>
		<Company>Jumoo</Company>

		<PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/Jumoo/Jumoo.TranslationManager.Automate</PackageProjectUrl>
		<PackageTags>Umbraco</PackageTags>

		<RepositoryUrl>https://github.com/Jumoo/Jumoo.TranslationManager.Automate</RepositoryUrl>

		<Copyright>Jumoo @ 2013-2026</Copyright>

		<!-- No logo asset checked in yet - set PackageIcon once assets/translation-manager-logo.png exists. -->
		<PackageIcon Condition="Exists('$(MSBuildThisFileDirectory)assets/translation-manager-logo.png')">translation-manager-logo.png</PackageIcon>

		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>

		<NoWarn>NU1902</NoWarn>
		<NuGetAuditMode>direct</NuGetAuditMode>

		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- don't append the build onto the version -->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)assets/translation-manager-logo.png" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)assets/translation-manager-logo.png')" />
	</ItemGroup>
</Project>
